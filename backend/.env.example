# Copy this file to .env for local development and replace the values.
APP_NAME=SprintIX
APP_ENV=development
PUBLIC_APP_URL=http://localhost:3000
WORKSPACE_DOMAIN=localhost:3000
ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_V1_PREFIX=/api/v1

# PostgreSQL database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pms_db
DB_USER=postgres
DB_PASSWORD=change_me

# Authentication: generate a long random value before deployment.
SECRET_KEY=replace_with_a_long_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Workspace onboarding and trial
TRIAL_DURATION_DAYS=14
TERMS_VERSION=demo-2026-10

# Email delivery (needed for production signup and invitations)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Optional AI integration
GROQ_API_KEY=
