# ==========================================================
# APPLICATION CONFIGURATION
# ==========================================================

APP_NAME=Project Management System
APP_VERSION=1.0.0
APP_DESCRIPTION=Production Ready Project Management API
API_V1_PREFIX=/api/v1

# ==========================================================
# DEBUG
# ==========================================================

DEBUG=True

# ==========================================================
# DATABASE CONFIGURATION
# ==========================================================

DB_HOST=localhost
DB_PORT=5432
DB_NAME=pms_db
DB_USER=postgres
DB_PASSWORD=2001

# Optional (leave commented if you want DATABASE_URL to be
# generated automatically by config.py)
# DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/pms_db

# ==========================================================
# JWT CONFIGURATION
# ==========================================================

SECRET_KEY=replace_with_a_long_random_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==========================================================
# LOGGING
# ==========================================================

LOG_LEVEL=INFO
LOG_FILE=logs/application.log

# ==========================================================
# CORS
# ==========================================================

ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000